{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Excluded from the app's type-check because they aren't React Native code:
  // - supabase/functions: Deno (jsr:/npm: specifiers, .ts imports, Deno global),
  //   type-checked by the Deno runtime at deploy time.
  // - *.test.ts: Node harnesses run with `npx tsx`, using node: imports and
  //   explicit .ts extensions. They are never bundled into the app.
  "exclude": ["node_modules", "supabase/functions", "**/*.test.ts"]
}
