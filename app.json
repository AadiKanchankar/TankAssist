{
  "expo": {
    "name": "TankAssist-Codex",
    "slug": "TankAssist-Codex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TankAssist needs your location to record attendance and store visit check-ins."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TankAssist uses the microphone for voice notes.",
          "speechRecognitionPermission": "TankAssist transcribes your speech to fill in notes. No audio is stored.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/0b5be692-f895-4931-849f-6410e6343be5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TankAssistCodex",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCiO0QLSvsKN6XMsu4PYqAb701GnIwRfrc"
        }
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0b5be692-f895-4931-849f-6410e6343be5"
      }
    },
    "owner": "tankassist"
  }
}
